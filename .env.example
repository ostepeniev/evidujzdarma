# --- základ ---
NEXT_PUBLIC_SITE_URL=https://evidujzdarma.cz
DATABASE_URL=postgres://evidujzdarma:CHANGE_ME@127.0.0.1:5432/evidujzdarma

# --- e-mail (libovolný SMTP v EU: Seznam Email Profi, Ecomail, Brevo, Postmark EU, AWS SES eu-central-1) ---
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="EvidujZdarma <ahoj@evidujzdarma.cz>"

# --- bezpečnost ---
# 32 bajtů base64 — šifruje klíče certifikátů (envelope encryption). openssl rand -base64 32
# Jen pro vývoj: produkce ho bere výhradně ze souboru MASTER_KEY_FILE (docker secret, viz docs/deploy.md).
MASTER_KEY=
# podpis schválení vratek a odhlašovacích odkazů v e-mailech. openssl rand -base64 32
# Pozor: změna zneplatní odhlašovací odkazy v už odeslaných e-mailech.
APP_SECRET=
# sdílené tajemství workeru pro POST /api/internal/cron. openssl rand -base64 32
CRON_SECRET=
# kam worker pošle alert, když cron opakovaně selhává (jen provozovatel)
ALERT_EMAIL=

# rotace master klíče: MASTER_KEY_v2(_FILE)=…, MASTER_KEY_CURRENT=v2 (starší verze zůstávají pro dešifrování)
# MASTER_KEY_CURRENT=v1

# --- EET ---
# Režim (ukázkový / Playground / ostrý) volí každý účet sám v nastavení; adresy FS jsou v kódu.
# časový limit jednoho odeslání do FS v ms (1 000–30 000, výchozí 10 000)
# EET_TIMEOUT_MS=10000

# --- volitelné ---
# ARES_MOCK=1                 # vývoj bez přístupu do ARES
# ARES_MEMORY_MAX=2000        # strop paměťové cache ARES (položek)
# DATABASE_POOL_MAX=10

# --- SEO ---
INDEXNOW_KEY=
