	email {$ACME_EMAIL}
}

# Hlavní doména — automatické HTTPS (Let's Encrypt), HTTP/3, komprese
{$DOMAIN} {
	encode zstd gzip
	# limity těla požadavků (R3.2): pokladní certifikát má pár kB, nic jiného nepotřebuje víc než 1 MB
	@certificate path /api/ucet/certifikat
	request_body @certificate {
		max_size 128KB
	}
	request_body {
		max_size 1MB
	}
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
	}
	# interní endpoint nikdy nevystavovat ven
	@internal path /api/internal/*
	respond @internal 404
	header -Server
}

# www a doplňkové domény (např. uctenkazdarma.cz) → přesměrování na hlavní doménu
www.{$DOMAIN} {$ALT_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}
