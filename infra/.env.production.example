# ── Doména a HTTPS ─────────────────────────────────────────────
DOMAIN=evidujzdarma.cz
# další VLASTNĚNÉ domény přesměrované na hlavní (oddělené mezerou), např. "uctenkazdarma.cz www.uctenkazdarma.cz"
ALT_DOMAINS=
ACME_EMAIL=admin@evidujzdarma.cz

# ── Tajné hodnoty ──────────────────────────────────────────────
# hesla DB jsou v DATABASE_URL, proto jen hex:  openssl rand -hex 32
POSTGRES_PASSWORD=
# heslo role evidujzdarma_app, pod kterou jedou web a worker (bez práva měnit schéma)
APP_DB_PASSWORD=
# ostatní:  openssl rand -base64 32
APP_SECRET=
CRON_SECRET=
# MASTER_KEY sem NEPATŘÍ: je v souboru secrets/master_key (0400, vlastník 1001), viz docs/deploy.md.
# Uložte ho i zvlášť v trezoru hesel – v zálohách není.

# ── E-mail (SMTP v EU, např. Seznam Email Profi, Ecomail, Brevo, Postmark EU, AWS SES eu-central-1)
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="EvidujZdarma <ahoj@evidujzdarma.cz>"
# kam worker pošle alert, když cron (odesílání tržeb) opakovaně selhává – jen provozovatel
ALERT_EMAIL=admin@evidujzdarma.cz

# ── Obsah a katalog ────────────────────────────────────────────
# kódy krajů, jejichž firmy se indexují (51 = Karlovarský)
CATALOG_INDEX_REGIONS=51
# noční obohacení katalogu z ARES (1 = zapnuto)
CATALOG_ENRICH=0
# návody před revizí daňovým poradcem neindexovat (0) / indexovat (1)
GUIDES_INDEX_UNREVIEWED=0
INDEXNOW_KEY=

# ── Monitor dostupnosti EET (/stav-eet) ────────────────────────
# interval měření v sekundách (výchozí 300); FS_MONITOR=0 měření vypne
FS_PROBE_INTERVAL_SEC=300

# ── Zálohy ─────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# VEŘEJNÝ klíč age (age1…), kterým se zálohy šifrují. Pár vygenerujte NA SVÉM počítači:
#   age-keygen -o evidujzdarma-backup.key   → soukromý klíč zůstane u vás offline, sem jen „public key“
BACKUP_AGE_RECIPIENT=
