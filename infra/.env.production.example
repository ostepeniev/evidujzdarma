# ── Doména a HTTPS ─────────────────────────────────────────────
DOMAIN=evidujzdarma.cz
# další VLASTNĚNÉ domény přesměrované na hlavní (oddělené mezerou), např. "uctenkazdarma.cz www.uctenkazdarma.cz"
ALT_DOMAINS=
ACME_EMAIL=admin@evidujzdarma.cz

# ── Provozovatel (zobrazuje se v patičce a O nás) ──────────────
OPERATOR_ICO=
OPERATOR_ADDRESS=

# ── Tajné hodnoty: vygenerujte  `openssl rand -base64 32` ──────
POSTGRES_PASSWORD=
APP_SECRET=
CRON_SECRET=
# MASTER_KEY šifruje privátní klíče certifikátů. ULOŽTE HO ZVLÁŠŤ (mimo server i zálohy).
MASTER_KEY=

# ── E-mail (SMTP v EU, např. Seznam Email Profi, Ecomail, Brevo, Postmark EU, AWS SES eu-central-1)
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="EvidujZdarma <ahoj@evidujzdarma.cz>"

# ── Obsah a katalog ────────────────────────────────────────────
# kódy krajů, jejichž firmy se indexují (51 = Karlovarský)
CATALOG_INDEX_REGIONS=51
# noční obohacení katalogu z ARES (1 = zapnuto)
CATALOG_ENRICH=0
# návody před revizí daňovým poradcem neindexovat (0) / indexovat (1)
GUIDES_INDEX_UNREVIEWED=0
INDEXNOW_KEY=

# ── Monitor dostupnosti EET (/stav-eet) ────────────────────────
# interval měření v sekundách (výchozí 300); FS_MONITOR=0 měření vypne
FS_PROBE_INTERVAL_SEC=300

# ── Zálohy ─────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
